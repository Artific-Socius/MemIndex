# ============================================================
# UniversalBenchmark 环境配置
# ============================================================
# 本文件为固定路径的统一环境配置，放置于 UniversalBenchmark 根目录下。
# 通过此文件可向各 Memory 实现传递自定义参数，无需修改命令行。
#
# 使用方法:
#   1. 复制本文件为 env_config.yaml
#   2. 修改 X-Mark 为你自己的标识（必须修改，否则无法追溯日志归属）
#
# 支持的配置段:
#   memory.<type>   — 传递给对应 Memory 实现的构造参数
#   agent           — 传递给 Agent 的全局参数
# ============================================================

memory:

  # ── Memecho ────────────────────────────────────────────────
  memecho:
    custom_headers:
      # [必须修改] X-Mark 用于标识请求来源，便于在 Memecho 服务端追溯日志。
      # 不修改此值将无法区分你的请求和其他人的请求。
      #
      # 格式: 最多三层，用 / 分隔
      #   第一层 — 你的名字或团队名（必填）
      #   第二层 — 数据集或实验名（可选）
      #   第三层 — 具体的运行标识（可选）
      #
      # 示例:
      #   X-Mark: zhangsan
      #   X-Mark: zhangsan/EverMemBench
      #   X-Mark: zhangsan/EverMemBench/run1
      X-Mark: your_name/benchmark_name/run_id

  # ── Buffer ─────────────────────────────────────────────────
  # buffer:
  #   max_turns: 50

  # ── Mem0 ───────────────────────────────────────────────────
  # mem0:
  #   recent_turns: 5

# agent:
#   agent_tag: "benchmark"
